# Android Local Config
desifit/android/local.properties
desifit/android/app/key.jks
desifit/android/key.properties

# Secrets and keys
*.keystore
*.jks

# Env files: hide dotenv files (including the .local/.production/.staging
# variants that carry real secrets) but never a committed .env.example template.
.env
.env.*
!.env.example

# No blanket *.properties rule: it silently hides committed config files
# such as android/gradle.properties. Android secrets (local.properties,
# key.properties, keystores) are ignored by each app's android/.gitignore
# and the explicit rules above.

# IDEs
.idea/
*.iml
.vscode/
desifit/.idea/
desifit/*.iml
desifit/.vscode/

# Operating System
.DS_Store
Thumbs.db
