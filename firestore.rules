// =============================================================================
// Security model for the DesiFit Firestore database.
//
// THIS FILE is the real security boundary. The Firebase client config that is
// committed next to the apps (desifit/android/app/google-services.json and
// desifit/lib/firebase_options.dart) contains only client-side identifiers
// (API keys, app ids) that ship in the app binary anyway -- they are NOT
// secrets, so keeping them tracked is fine and intentional. Access control
// lives exclusively in the rules below. Never commit a service-account key
// or any other private key; the CI gate tools/check_no_private_keys.js fails
// the build if one appears.
//
// Model: users own their own documents; authenticated users may read shared
// collections (leaderboard, community hacks) but writes are owner-scoped and
// community posts must self-declare an authorId equal to the caller's uid.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Checks if the requesting user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Users can only read and write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Leaderboard Collection: Authenticated users can read the leaderboard,
    // but only the owner can write/update their own score entry.
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Community Food Hacks: Authenticated users can read hacks,
    // but can only write if they are authenticated and set their own uid as the author.
    match /community_hacks/{hackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
  }
}
